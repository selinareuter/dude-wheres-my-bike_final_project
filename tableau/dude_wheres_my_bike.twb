      </connection>
      <aliases enabled='yes' />
      <column caption='Number of Reports' datatype='integer' name='[Calculation_0488216134934528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='Average Reports per Day' datatype='real' name='[Calculation_0488216135122945]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([offence_start_date])&#13;&#10;/&#13;&#10;COUNTD(DATE([offence_start_date]))' />
      </column>
      <column caption='Day Type' datatype='string' name='[Calculation_0488216136122370]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_weekend] THEN&#13;&#10;    &quot;Weekend&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Weekday&quot;&#13;&#10;END' />
      </column>
      <column caption='Time Period' datatype='string' name='[Calculation_0488216147058692]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0488216149274630] &lt; 6 THEN &quot;Night&quot;&#13;&#10;ELSEIF [Calculation_0488216149274630] &lt; 12 THEN &quot;Morning&quot;&#13;&#10;ELSEIF [Calculation_0488216149274630] &lt; 18 THEN &quot;Afternoon&quot;&#13;&#10;ELSE &quot;Evening&quot;&#13;&#10;END' />
      </column>
      <column caption='Offence Window Hours Numeric' datatype='real' name='[Calculation_0488216147189765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='FLOAT([offence_window_hours])' />
      </column>
      <column caption='Offence Midpoint Hour' datatype='real' name='[Calculation_0488216149274630]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    FLOAT([offence_start_hour])&#13;&#10;    + FLOAT([offence_window_hours]) / 2&#13;&#10;) % 24' />
      </column>
      <column caption='District Map Filter' datatype='boolean' name='[Calculation_1008011015630848]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[District Name Parameter] = &quot;All Berlin&quot;&#13;&#10;OR [district_name] = [Parameters].[District Name Parameter]' />
      </column>
      <column caption='Selected Report Count' datatype='integer' name='[Calculation_1008011292946434]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF&#13;&#10;        (&#13;&#10;            [Parameters].[Parameter 1] = &quot;All years&quot;&#13;&#10;            OR STR([year]) = [Parameters].[Parameter 1]&#13;&#10;        )&#13;&#10;        AND&#13;&#10;        (&#13;&#10;            [Parameters].[Parameter 2] = &quot;All bicycle types&quot;&#13;&#10;            OR [bicycle_type] = [Parameters].[Parameter 2]&#13;&#10;        )&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Positive Reported Damage' datatype='boolean' name='[Calculation_1457710860451840]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[reported_damage_eur] &gt; 0' />
